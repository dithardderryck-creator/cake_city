{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && npm --prefix web install",
  "buildCommand": "npm run build --prefix web",
  "devCommand": "npm --prefix web run dev",
  "outputDirectory": "web/dist",
  "functions": {
    "api/*.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/graphql", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/((?!api/|assets/|static/).*)", "destination": "/index.html" }
  ]
}
