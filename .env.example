# ── Cake City POS – production environment template ─────────────────
# Copy to .env and fill in real values BEFORE the first db:reset.

# PostgreSQL connection
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/cakecity

# API port
PORT=4000

# Secret used to sign JWTs. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Initial owner account created automatically by `npm run db:init`.
# Choose a strong 4-digit (or longer) PIN now — the shop sets the rest
# of the staff up from the UI after first login.
CAKE_OWNER_JINA=Mmiliki Mkuu
CAKE_OWNER_PIN=
# ── Optional hardening / deployment settings (new) ──────────────────
# Leave these unset for a normal single-shop install on the shop's own PC.

# Browser origins allowed to call this API. Comma-separated.
#
# Every deployed frontend needs its origin here — a deployed app that is missing
# from this list loads but cannot log in, because the browser blocks the call.
# This is the switchboard for running several front ends against one backend:
# add an origin to admit that client, remove it to revoke it.
#
# Only localhost is pre-allowed, for development. There is deliberately no
# built-in public origin: an origin nobody is tracking is an origin that keeps
# working after the project is renamed, sold or handed over.
#
# Set to * to allow any origin (only safe behind your own proxy).
# CORS_ORIGINS=https://cakecity.vercel.app,https://pos.example.co.tz

# Timezone every database session runs in. "Today" on the dashboard and the
# ticket engine both resolve through this, so it must be the shop's timezone.
# DB_TIMEZONE=Africa/Dar_es_Salaam

# Only for a managed Postgres whose CA certificate you cannot install.
# Disables TLS certificate verification and prints a loud warning.
# DB_INSECURE_TLS=false

# Set to true when deploying to a serverless host, where the in-process
# reminder timer cannot be relied on to fire. Trigger reminder generation
# from the tengeneza_ukumbusho mutation or an external cron instead.
# DISABLE_REMINDER_TIMER=false

# How many proxies sit between the internet and this process. Deployed, every
# request arrives from the platform's edge, so without this the login throttle
# sees one shared address for every caller — five fumbled PINs anywhere would
# then lock out the whole shop. Vercel is one hop; Cloudflare in front of Vercel
# is two. On the shop's own PC, leave it unset.
# TRUST_PROXY_HOPS=1

# Login throttle tuning. The defaults are the values decision A1 was verified
# against. Raise LOGIN_MAX_ATTEMPTS only if staff legitimately share one public
# address (a shared NAT egress) and get locked out of each other.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_MS=900000
# LOGIN_LOCKOUT_MS=900000
